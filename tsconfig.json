// TypeScript is used for type-checking only (`pnpm typecheck`); Vite does the
// actual transpiling and bundling, so nothing is emitted here.
{
  "compilerOptions": {
    // Matches Vite's default browser target (modern, "baseline widely available").
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // Adds types for `import "./x.css"`, `import.meta.env`, etc.
    "types": ["vite/client"],

    "noEmit": true,
    "skipLibCheck": true,

    // Each file must be transpilable on its own (required by Vite/esbuild/oxc).
    "isolatedModules": true,
    // Type-only imports must use `import type`, so they're erased predictably.
    "verbatimModuleSyntax": true,

    // Strictness
    "strict": true,
    // `arr[i]` / `record[key]` may be undefined. Catches missing DOM nodes & data.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },

  "include": ["src/**/*.ts", "vite.config.ts"]
}
