// Shared workspace settings. Personal preferences belong in your user settings.
{
  // Lets the Tailwind CSS extension understand @theme/@source/@utility in our
  // CSS (otherwise VS Code flags them as unknown at-rules).
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // Tailwind v4 has no tailwind.config.js; point IntelliSense at the CSS entry.
  "tailwindCSS.experimental.configFile": "src/styles/main.css",
  // Class-name autocomplete/hover inside .liquid files.
  "tailwindCSS.includeLanguages": {
    "liquid": "html"
  },

  // Generated by `pnpm build`. Edit src/ instead.
  "files.readonlyInclude": {
    "assets/theme.css": true,
    "assets/theme.js": true
  },
  "search.exclude": {
    "assets/theme.css": true,
    "assets/theme.js": true,
    "pnpm-lock.yaml": true
  }
}
