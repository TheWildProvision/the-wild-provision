{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
  assign category_keys = 'pet-food-flavor,pet-supply-product-form,pet-dietary-requirements,package-type' | split: ','
-%}
<section
  class="container product"
  aria-labelledby="ProductTitle-{{ section.id }}"
  data-product
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-root-url="{{ routes.root_url }}"
  data-adding="{{ 'products.product.adding' | t | escape }}"
  data-added="{{ 'products.product.added' | t | escape }}"
  data-view-cart="{{ 'products.product.view_cart' | t | escape }}"
  data-error="{{ 'products.product.cart_error' | t | escape }}"
  data-network-error="{{ 'products.product.network_error' | t | escape }}"
>
  <div class="product__gallery" data-gallery>
    <div data-variant-region="media">
      <div class="product__main-media media">
        {%- if featured_media != blank -%}
          {%- assign main_alt = featured_media.alt | default: product.title -%}
          {{ featured_media.preview_image | image_url: width: 1800 | image_tag: widths: '480, 750, 1000, 1400, 1800', sizes: '(max-width: 800px) 100vw, 55vw', loading: 'eager', fetchpriority: 'high', alt: main_alt, data-gallery-image: '' }}
        {%- elsif request.design_mode -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- assign gallery_images = product.media | where: 'media_type', 'image' -%}
      {%- if gallery_images.size > 1 -%}
        <ul class="product__thumbs list-reset js-only" aria-label="{{ 'accessibility.product_gallery' | t }}">
          {%- for media in gallery_images -%}
            <li>
              <button
                class="product__thumb"
                type="button"
                data-gallery-thumb
                data-src="{{ media | image_url: width: 1800 }}"
                data-srcset="{{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1400 }} 1400w, {{ media | image_url: width: 1800 }} 1800w"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
              >
                <span class="visually-hidden">{{ 'accessibility.show_image' | t: number: forloop.index }}</span>
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for media in product.media -%}
      {%- case media.media_type -%}
        {%- when 'video' -%}
          <div class="product__extra-media">{{ media | video_tag: controls: true, image_size: '1000x', preload: 'none' }}</div>
        {%- when 'external_video' -%}
          <div class="product__extra-media">{{ media | external_video_tag: loading: 'lazy' }}</div>
        {%- when 'model' -%}
          <div class="product__extra-media">{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}</div>
        {%- when 'image' -%}
          {%- unless media.id == featured_media.id -%}
            {%- assign extra_alt = media.alt | default: '' -%}
            <noscript>
              <div class="product__extra-media">{{ media | image_url: width: 1000 | image_tag: loading: 'lazy', alt: extra_alt }}</div>
            </noscript>
          {%- endunless -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="product__info">
    {% render 'breadcrumb', product: product, collection: collection %}

    {%- assign eyebrow = product.type | default: section.settings.eyebrow -%}
    {%- if eyebrow != blank -%}
      <p class="product__eyebrow label">{{ eyebrow | escape }}</p>
    {%- endif -%}
    <h1 id="ProductTitle-{{ section.id }}" class="product__title">{{ product.title | escape }}</h1>

    <div class="product__price" data-variant-region="price">
      {% render 'price',
        amount: current_variant.price,
        compare_at: current_variant.compare_at_price,
        unit_price: current_variant.unit_price,
        unit_measurement: current_variant.unit_price_measurement
      %}
    </div>

    {%- if product.description != blank -%}
      <div class="product__description rte text-muted">{{ product.description }}</div>
    {%- endif -%}

    <dl class="product__facts text-small" data-variant-region="facts">
      {%- if product.metafields.custom.ingredient != blank -%}
        <div>
          <dt>{{ 'products.facts.ingredient' | t }}</dt>
          <dd>{{ product.metafields.custom.ingredient.value | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if product.metafields.custom.origin != blank -%}
        <div>
          <dt>{{ 'products.facts.origin' | t }}</dt>
          <dd>{{ product.metafields.custom.origin.value | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if product.metafields.custom.processing != blank -%}
        <div>
          <dt>{{ 'products.facts.processing' | t }}</dt>
          <dd>{{ product.metafields.custom.processing.value | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if current_variant.weight > 0 -%}
        <div>
          <dt>{{ 'products.facts.net_weight' | t }}</dt>
          <dd>{{ current_variant.weight_in_unit | weight_with_unit: current_variant.weight_unit }}</dd>
        </div>
      {%- endif -%}
      {%- for key in category_keys -%}
        {%- assign attribute = product.metafields.shopify[key] -%}
        {%- if attribute != blank -%}
          <div>
            <dt>
              {%- case key -%}
                {%- when 'pet-food-flavor' -%}{{ 'products.facts.flavour' | t }}
                {%- when 'pet-supply-product-form' -%}{{ 'products.facts.form' | t }}
                {%- when 'pet-dietary-requirements' -%}{{ 'products.facts.dietary' | t }}
                {%- when 'package-type' -%}{{ 'products.facts.package' | t }}
              {%- endcase -%}
            </dt>
            <dd>{{ attribute | metafield_text: field: 'label' }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

    {%- if request.design_mode and product.metafields.custom.ingredient == blank -%}
      <p class="editor-note">{{ 'sections.product.facts_missing' | t }}</p>
    {%- endif -%}

    {%- if product.requires_selling_plan -%}
      {%- if request.design_mode -%}
        <p class="editor-note">{{ 'sections.product.selling_plan' | t }}</p>
      {%- endif -%}
    {%- else -%}
      {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '', data-ajax: settings.enable_ajax_cart -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- else -%}
          <div class="form-field">
            <label for="Variant-{{ section.id }}">{{ 'products.product.variant' | t }}</label>
            <select class="field" id="Variant-{{ section.id }}" name="id" data-variant-select>
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>
                  {{- variant.title | escape -}}
                  {%- unless variant.available %} &ndash; {{ 'products.product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="product-form__purchase" data-variant-region="purchase">
          <div class="quantity">
            <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
            <button class="quantity__step js-only" type="button" data-quantity-step="-1">
              <span aria-hidden="true">&minus;</span>
              <span class="visually-hidden">{{ 'products.product.decrease' | t }}</span>
            </button>
            <input
              class="quantity__input"
              id="Quantity-{{ section.id }}"
              type="number"
              name="quantity"
              value="{{ current_variant.quantity_rule.min }}"
              min="{{ current_variant.quantity_rule.min }}"
              step="{{ current_variant.quantity_rule.increment }}"
              {% if current_variant.quantity_rule.max != null %}
                max="{{ current_variant.quantity_rule.max }}"
              {% endif %}
              inputmode="numeric"
              required
            >
            <button class="quantity__step js-only" type="button" data-quantity-step="1">
              <span aria-hidden="true">+</span>
              <span class="visually-hidden">{{ 'products.product.increase' | t }}</span>
            </button>
          </div>
          <button
            class="button button--solid button--full"
            type="submit"
            name="add"
            data-add-button
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span data-add-label>
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="arrow" aria-hidden="true">&rarr;</span>
          </button>
        </div>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="product-form__checkout">{{ form | payment_button }}</div>
        {%- endif -%}
        <div class="product-form__installments text-small">{{ form | payment_terms }}</div>
        <div class="product-form__status form-message" role="status" data-add-status></div>
        {%- if section.settings.purchase_note != blank -%}
          <p class="text-small text-muted">{{ section.settings.purchase_note | escape }}</p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <div class="product__disclosures">
      {%- if product.metafields.custom.feeding_guide != blank -%}
        <details class="accordion">
          <summary>{{ 'products.product.feeding_guide' | t }}</summary>
          <div class="accordion__content rte">{{ product.metafields.custom.feeding_guide | metafield_tag }}</div>
        </details>
      {%- endif -%}
      {%- if product.metafields.custom.storage_guide != blank -%}
        <details class="accordion">
          <summary>{{ 'products.product.storage_guide' | t }}</summary>
          <div class="accordion__content rte">{{ product.metafields.custom.storage_guide | metafield_tag }}</div>
        </details>
      {%- endif -%}
      {%- if section.settings.delivery_page != blank -%}
        <details class="accordion">
          <summary>{{ section.settings.delivery_page.title | escape }}</summary>
          <div class="accordion__content rte">{{ section.settings.delivery_page.content }}</div>
        </details>
      {%- elsif shop.shipping_policy != blank -%}
        <details class="accordion">
          <summary>{{ 'products.product.delivery' | t }}</summary>
          <div class="accordion__content rte">
            {{ shop.shipping_policy.body }}
            {%- if shop.refund_policy != blank -%}
              <p><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></p>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'accordion' -%}
            {%- if block.settings.text != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | escape }}</summary>
                <div class="accordion__content rte">{{ block.settings.text }}</div>
              </details>
            {%- endif -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% stylesheet %}
  .product {
    display: grid;
    grid-template-columns: 1.16fr 1fr;
    align-items: start;
    gap: clamp(var(--space-6), 5vw, 6rem);
    padding-block: var(--space-6) var(--space-section);
  }

  .product__gallery {
    min-width: 0;
  }

  .product__main-media {
    aspect-ratio: var(--ratio-portrait);
    max-height: 56rem;
  }

  .product__main-media img {
    object-fit: contain;
  }

  .product__thumbs {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-1);
    overflow-x: auto;
  }

  .product__thumb {
    flex: 0 0 4.75rem;
    border: var(--border-width) solid transparent;
  }

  .product__thumb[aria-pressed='true'] {
    border-color: var(--color-text);
  }

  .product__thumb img {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .product__extra-media {
    margin-top: var(--space-4);
  }

  .product__extra-media :is(video, iframe, model-viewer) {
    width: 100%;
    aspect-ratio: 1;
  }

  .product__info {
    display: grid;
    gap: var(--space-5);
    container-type: inline-size;
  }

  .product__eyebrow {
    margin-bottom: calc(var(--space-3) * -1);
  }

  .product__facts {
    border-top: var(--border-width) solid var(--color-rule);
  }

  .product__facts:empty {
    display: none;
  }

  .product__facts > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-rule);
  }

  .product__facts dt {
    color: var(--color-text-muted);
  }

  .product-form {
    display: grid;
    gap: var(--space-4);
  }

  .product-form__purchase {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-3);
  }

  .quantity {
    display: flex;
    align-items: stretch;
    min-height: var(--control-height);
    border: var(--border-width) solid var(--color-control);
  }

  .quantity__step {
    flex: 0 0 2rem;
  }

  .quantity__input {
    flex: 1;
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    text-align: center;
  }

  .product-form__status:empty {
    display: none;
  }

  .product-form__status a {
    margin-left: var(--space-2);
  }

  .product__disclosures {
    border-top: var(--border-width) solid var(--color-rule);
  }

  @media (max-width: 800px) {
    .product {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const regions = (root) => root.querySelectorAll('[data-variant-region]');

    const renderVariant = async (section, variantId) => {
      const url = new URL(section.dataset.url, window.location.origin);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', `${window.location.pathname}?variant=${variantId}`);
      url.searchParams.set('section_id', section.dataset.sectionId);
      try {
        const response = await fetch(url);
        if (!response.ok) return;
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        regions(section).forEach((region) => {
          const next = html.querySelector(`[data-variant-region="${region.dataset.variantRegion}"]`);
          if (next) region.replaceWith(next);
        });
      } catch (error) {
        section.querySelector('[data-add-status]')?.replaceChildren();
      }
    };

    const refreshCartCount = async (root) => {
      const response = await fetch(`${root}cart.js`, { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const cart = await response.json();
      document.dispatchEvent(new CustomEvent('twp:cart-updated', { detail: { itemCount: cart.item_count } }));
    };

    const statusWithLink = (status, message, strings, isError) => {
      const link = document.createElement('a');
      link.className = 'text-link';
      link.href = strings.cartUrl;
      link.textContent = strings.viewCart;
      status.classList.toggle('form-message--error', isError);
      status.replaceChildren(message, link);
    };

    document.addEventListener('change', (event) => {
      const select = event.target.closest('[data-variant-select]');
      if (select) renderVariant(select.closest('[data-product]'), select.value);
    });

    document.addEventListener('click', (event) => {
      const step = event.target.closest('[data-quantity-step]');
      if (step) {
        const input = step.parentElement.querySelector('input[type="number"]');
        const increment = Number(input.step) || 1;
        const min = Number(input.min) || 1;
        const max = input.max ? Number(input.max) : Infinity;
        const next = (Number(input.value) || min) + Number(step.dataset.quantityStep) * increment;
        input.value = String(Math.min(max, Math.max(min, next)));
        return;
      }

      const thumb = event.target.closest('[data-gallery-thumb]');
      if (thumb) {
        const gallery = thumb.closest('[data-gallery]');
        const image = gallery.querySelector('[data-gallery-image]');
        if (!image) return;
        image.srcset = thumb.dataset.srcset;
        image.src = thumb.dataset.src;
        image.alt = thumb.dataset.alt;
        gallery.querySelectorAll('[data-gallery-thumb]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button === thumb));
        });
      }
    });

    document.addEventListener('submit', async (event) => {
      const form = event.target.closest('[data-product-form]');
      if (!form || form.dataset.ajax !== 'true') return;
      event.preventDefault();
      const strings = form.closest('[data-product]').dataset;
      if (form.dataset.busy === 'true') return;

      const button = form.querySelector('[data-add-button]');
      const label = button.querySelector('[data-add-label]');
      const status = form.querySelector('[data-add-status]');
      const idleLabel = label.textContent;
      form.dataset.busy = 'true';
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      label.textContent = strings.adding;
      status.replaceChildren();

      try {
        const response = await fetch(`${strings.rootUrl}cart/add.js`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await response.json();
        if (!response.ok || data.status) {
          statusWithLink(status, `${data.description || strings.error} `, strings, true);
        } else {
          statusWithLink(status, `${strings.added} `, strings, false);
        }
        await refreshCartCount(strings.rootUrl);
      } catch (error) {
        statusWithLink(status, `${strings.networkError} `, strings, true);
      } finally {
        form.dataset.busy = 'false';
        button.disabled = false;
        button.removeAttribute('aria-busy');
        label.textContent = idleLabel;
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product.eyebrow",
      "info": "t:sections.product.eyebrow_info"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.product.show_dynamic_checkout",
      "info": "t:sections.product.show_dynamic_checkout_info",
      "default": true
    },
    {
      "type": "text",
      "id": "purchase_note",
      "label": "t:sections.product.purchase_note",
      "default": "t:defaults.product.purchase_note"
    },
    {
      "type": "page",
      "id": "delivery_page",
      "label": "t:sections.product.delivery_page",
      "info": "t:sections.product.delivery_page_info"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "accordion",
      "name": "t:sections.product.accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "t:defaults.product.accordion_heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ]
}
{% endschema %}
