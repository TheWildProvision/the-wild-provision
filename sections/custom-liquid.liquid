<div class="container{% if section.settings.spacing %} section{% endif %}">
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.liquid"
    },
    {
      "type": "checkbox",
      "id": "spacing",
      "label": "t:sections.custom_liquid.spacing",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.name"
    }
  ]
}
{% endschema %}
