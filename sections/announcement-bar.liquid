{%- if section.settings.text != blank -%}
  <div class="announcement surface--dark text-small">
    {%- if section.settings.link != blank -%}
      <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement {
    padding: var(--space-2) var(--gutter);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "t:defaults.announcement.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
