<div class="password">
  <header class="password__header">
    {% render 'brand', eager: true %}
    {%- if shop.brand.slogan != blank -%}
      <p class="label">{{ shop.brand.slogan | escape }}</p>
    {%- endif -%}
  </header>

  <div class="password__content">
    <div class="password__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank or shop.password_message != blank -%}
        <div class="password__text rte text-muted">
          {{ section.settings.text }}
          {%- if shop.password_message != blank -%}
            <p>{{ shop.password_message }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% render 'newsletter-form', id: section.id %}

      {%- form 'storefront_password', class: 'password__form' -%}
        <details class="password__entry"{% if form.errors %} open{% endif %}>
          <summary class="text-link text-small">{{ 'password.entry.toggle' | t }}</summary>
          <div class="form-grid">
            {%- if form.errors -%}
              <div id="PasswordErrors-{{ section.id }}" class="form-message form-message--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="form-field">
              <label for="StorePassword-{{ section.id }}">{{ 'password.entry.label' | t }}</label>
              <input
                class="field"
                id="StorePassword-{{ section.id }}"
                type="password"
                name="password"
                autocomplete="current-password"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="PasswordErrors-{{ section.id }}" autofocus
                {% endif %}
              >
            </div>
            <div>
              <button class="button" type="submit">
                {{- 'password.entry.submit' | t -}}
                <span class="arrow" aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </div>
        </details>
      {%- endform -%}
    </div>

    <div class="password__media media">
      {% render 'responsive-image', image: section.settings.image, eager: true, sizes: '(max-width: 800px) 100vw, 50vw', placeholder: 'lifestyle-2' %}
    </div>
  </div>

  <footer class="password__footer text-small">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    <a class="text-link" href="/admin">{{ 'password.entry.owner' | t }}</a>
  </footer>
</div>

{% stylesheet %}
  .password {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .password__header,
  .password__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-5) var(--gutter);
  }

  .password__header {
    border-bottom: var(--border-width) solid var(--color-rule);
  }

  .password__footer {
    border-top: var(--border-width) solid var(--color-rule);
  }

  .password__content {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr 1fr;
  }

  .password__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--gutter);
    container-type: inline-size;
  }

  .password__copy h1 em {
    display: block;
  }

  .password__text {
    max-width: var(--measure-narrow);
  }

  .password__entry summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .password__entry .form-grid {
    max-width: 24rem;
    margin-top: var(--space-3);
  }

  .password__media {
    min-height: 40.625rem;
  }

  @media (max-width: 800px) {
    .password__content {
      grid-template-columns: 1fr;
    }

    .password__media {
      min-height: 0;
      aspect-ratio: var(--ratio-landscape);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.password.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "t:defaults.password.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.password.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "t:defaults.password.text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_alt"
    }
  ]
}
{% endschema %}
