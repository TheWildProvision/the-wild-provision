<div
  class="container section product-recommendations"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <section aria-labelledby="Recommendations-{{ section.id }}">
      <h2 id="Recommendations-{{ section.id }}" class="product-recommendations__heading">
        {{- section.settings.heading | escape -}}
      </h2>
      <ul class="product-grid list-reset">
        {%- for recommendation in recommendations.products -%}
          {% render 'product-card', product: recommendation %}
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-recommendations:empty {
    padding: 0;
    border: 0;
  }

  .product-recommendations {
    border-top: var(--border-width) solid var(--color-rule);
  }

  .product-recommendations__heading {
    margin-bottom: var(--space-7);
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const load = async (container) => {
      const response = await fetch(container.dataset.url);
      if (!response.ok) return;
      const html = new DOMParser().parseFromString(await response.text(), 'text/html');
      const next = html.querySelector('[data-recommendations]');
      if (next && next.children.length) container.replaceChildren(...next.children);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          load(entry.target).catch(() => {});
        });
      },
      { rootMargin: '0px 0px 400px 0px' }
    );

    const observe = () => {
      document.querySelectorAll('[data-recommendations]:empty').forEach((container) => observer.observe(container));
    };

    observe();
    document.addEventListener('shopify:section:load', observe);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.recommendations.name",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.recommendations.heading"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.recommendations.intent",
      "info": "t:sections.recommendations.intent_info",
      "default": "related",
      "options": [
        {
          "value": "related",
          "label": "t:sections.recommendations.related"
        },
        {
          "value": "complementary",
          "label": "t:sections.recommendations.complementary"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.recommendations.limit",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 2
    }
  ],
  "presets": [
    {
      "name": "t:sections.recommendations.name"
    }
  ]
}
{% endschema %}
