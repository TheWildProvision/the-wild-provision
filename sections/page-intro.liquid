<div class="container">
  <header class="page-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="page-heading__lead rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </header>
</div>

{% schema %}
{
  "name": "t:sections.page_intro.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.page_intro.heading",
      "info": "t:sections.page_intro.heading_info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.lead"
    }
  ],
  "presets": [
    {
      "name": "t:sections.page_intro.name"
    }
  ]
}
{% endschema %}
