<div class="container section">
  <div class="faq">
    {%- if section.settings.heading != blank -%}
      <div class="faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="serif">{{ block.settings.question | escape }}</summary>
          <div class="accordion__content rte">
            {{ block.settings.answer }}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <p><a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a></p>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--space-7) var(--space-8);
  }

  .faq:not(:has(.faq__intro)) {
    grid-template-columns: minmax(0, var(--measure));
  }

  .faq__intro {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    container-type: inline-size;
  }

  .faq__list .accordion:first-child {
    border-top: var(--border-width) solid var(--color-rule);
  }

  @media (max-width: 800px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.faq.heading_info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.lead"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.question",
          "default": "t:defaults.faq.question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.answer",
          "default": "t:defaults.faq.answer"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
