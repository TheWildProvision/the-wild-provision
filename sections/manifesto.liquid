<section class="manifesto container section" aria-labelledby="Manifesto-{{ section.id }}">
  <div class="manifesto__grid">
    <p class="label">{{ section.settings.eyebrow | escape }}</p>
    <div class="manifesto__body">
      <h2 id="Manifesto-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="manifesto__text rte text-muted">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .manifesto {
    border-bottom: var(--border-width) solid var(--color-rule);
  }

  .manifesto__grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-5) var(--space-8);
  }

  .manifesto__body {
    max-width: 52rem;
  }

  .manifesto__body h2 {
    line-height: 1.18;
  }

  .manifesto__text {
    max-width: var(--measure-narrow);
    margin-top: var(--space-6);
  }

  @media (max-width: 800px) {
    .manifesto__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.manifesto.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "t:defaults.manifesto.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.manifesto.statement",
      "default": "t:defaults.manifesto.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "presets": [
    {
      "name": "t:sections.manifesto.name"
    }
  ]
}
{% endschema %}
