<div class="container section">
  <div class="rich-text measure">
    {%- if section.settings.eyebrow != blank -%}
      <p class="label">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.link != blank and section.settings.link_label != blank -%}
      <a class="arrow-link" href="{{ section.settings.link }}">
        {{- section.settings.link_label | escape -}}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rich-text {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.rich_text.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name"
    }
  ]
}
{% endschema %}
