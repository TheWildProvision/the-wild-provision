<section class="newsletter" aria-labelledby="NewsletterHeading-{{ section.id }}">
  <div class="container newsletter__grid">
    <div class="newsletter__copy">
      <h2 id="NewsletterHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="newsletter__text rte text-muted">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {% render 'newsletter-form', id: section.id %}
  </div>
</section>

{% stylesheet %}
  .newsletter {
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--color-rule);
  }

  .newsletter__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .newsletter__copy {
    container-type: inline-size;
  }

  .newsletter__text {
    max-width: var(--measure-narrow);
    margin-top: var(--space-4);
  }

  @media (max-width: 800px) {
    .newsletter__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.newsletter.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "t:defaults.newsletter.text"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
