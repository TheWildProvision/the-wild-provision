<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <button
      class="site-header__toggle js-only"
      type="button"
      aria-expanded="false"
      aria-controls="SiteNav-{{ section.id }}"
      data-menu-toggle
    >
      <span class="site-header__toggle-icon" aria-hidden="true"></span>
      <span class="site-header__toggle-label">{{ 'general.navigation.menu' | t }}</span>
    </button>

    <nav id="SiteNav-{{ section.id }}" class="site-nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
      {%- if section.settings.menu != blank -%}
        {% render 'menu', menu: section.settings.menu, block: 'site-nav', nested: true %}
      {%- elsif request.design_mode -%}
        <p class="editor-note">{{ 'sections.header.no_menu' | t }}</p>
      {%- endif -%}
      <ul class="site-nav__utility list-reset">
        <li><a class="site-nav__sublink" href="{{ routes.search_url }}">{{ 'general.search.title' | t }}</a></li>
        {%- if shop.customer_accounts_enabled and settings.show_account -%}
          <li><a class="site-nav__sublink" href="{{ routes.account_url }}">{{ 'general.navigation.account' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>

    {% render 'brand', eager: true %}

    <ul class="site-header__actions list-reset">
      <li class="site-header__wide-only">
        <a class="site-header__action" href="{{ routes.search_url }}">{{ 'general.search.title' | t }}</a>
      </li>
      {%- if shop.customer_accounts_enabled and settings.show_account -%}
        <li class="site-header__wide-only">
          <a class="site-header__action" href="{{ routes.account_url }}">{{ 'general.navigation.account' | t }}</a>
        </li>
      {%- endif -%}
      <li>
        <a class="site-header__action" href="{{ routes.cart_url }}">
          {{- 'general.cart.title' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)
        </a>
      </li>
    </ul>
  </div>
</header>

{% stylesheet %}
  .header-section {
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .header-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .header-section::before {
      background: color-mix(in srgb, var(--color-bg) 78%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(1.3);
      backdrop-filter: blur(14px) saturate(1.3);
    }
  }

  .site-header {
    border-bottom: var(--border-width) solid var(--color-rule);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-height);
  }

  .site-header .brand {
    grid-column: 2;
    grid-row: 1;
  }

  .site-header__toggle {
    display: none;
  }

  .site-nav {
    grid-column: 1;
    grid-row: 1;
    font-size: var(--text-small);
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
  }

  .site-nav__link::before {
    content: '';
    position: absolute;
    bottom: var(--space-2);
    left: 0;
    width: 0;
    height: var(--border-width);
    background: currentColor;
    transition: width var(--duration-fast);
  }

  .site-nav__link:hover::before,
  .site-nav__link[aria-current='page']::before,
  .site-nav__item.is-active > .site-nav__link::before,
  .site-nav__item.is-active > .site-nav__details > .site-nav__link::before {
    width: 100%;
  }

  .site-nav__details {
    position: relative;
  }

  .site-nav__details > summary {
    list-style: none;
  }

  .site-nav__details > summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__details > summary::after {
    content: '+';
  }

  .site-nav__details[open] > summary::after {
    content: '\2212';
  }

  .site-nav__details > .site-nav__sublist {
    position: absolute;
    top: 100%;
    left: calc(var(--space-5) * -1);
    z-index: 10;
    min-width: 14rem;
    padding: var(--space-3) var(--space-5);
    border: var(--border-width) solid var(--color-rule);
    background: var(--color-bg);
  }

  .site-nav__sublist .site-nav__sublist {
    padding-left: var(--space-4);
  }

  .site-nav__sublink {
    display: block;
    padding-block: var(--space-2);
  }

  .site-nav__sublink[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-nav__utility {
    display: none;
  }

  .site-header__actions {
    grid-column: 3;
    justify-self: end;
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-small);
  }

  .site-header__action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    .site-header__inner {
      gap: var(--space-3);
    }

    .site-header__toggle {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-width: var(--target-min);
      min-height: var(--target-min);
      font-size: var(--text-small);
    }

    .site-header__toggle-icon {
      position: relative;
      width: 1.125rem;
      height: 0.75rem;
      border-block: var(--border-width) solid;
    }

    .site-header__toggle-icon::after {
      content: '';
      position: absolute;
      top: calc(50% - var(--border-width) / 2);
      left: 0;
      width: 0.75rem;
      border-top: var(--border-width) solid;
    }

    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      padding-block: var(--space-4) var(--space-6);
      border-top: var(--border-width) solid var(--color-rule);
    }

    .js .site-header__toggle {
      position: relative;
      z-index: 3;
    }

    .js .site-header[data-menu-open] .site-header__toggle-icon {
      border-color: transparent;
    }

    .js .site-header[data-menu-open] .site-header__toggle-icon::before,
    .js .site-header[data-menu-open] .site-header__toggle-icon::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      border-top: var(--border-width) solid currentColor;
    }

    .js .site-header[data-menu-open] .site-header__toggle-icon::before {
      transform: rotate(45deg);
    }

    .js .site-header[data-menu-open] .site-header__toggle-icon::after {
      transform: rotate(-45deg);
    }

    .js .site-header::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 1;
      background: var(--color-scrim);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-slow) var(--ease);
    }

    .js .site-header[data-menu-open]::before {
      opacity: 1;
      pointer-events: auto;
    }

    .js .site-nav {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 2;
      width: min(22rem, 85vw);
      padding: 5.5rem var(--gutter) var(--space-7);
      overflow-y: auto;
      border-top: 0;
      background: var(--color-bg);
      visibility: hidden;
      transform: translateX(-100%);
      transition:
        transform var(--duration-slow) var(--ease),
        visibility 0s linear var(--duration-slow);
    }

    .js .site-header[data-menu-open] .site-nav {
      visibility: visible;
      transform: none;
      transition: transform var(--duration-slow) var(--ease);
    }

    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
      .js .site-nav {
        background: color-mix(in srgb, var(--color-bg) 82%, transparent);
        -webkit-backdrop-filter: blur(18px) saturate(1.3);
        backdrop-filter: blur(18px) saturate(1.3);
      }
    }

    .site-nav__list {
      display: block;
    }

    .site-nav__link {
      font-family: var(--font-serif);
      font-size: var(--text-heading);
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-heading);
    }

    .site-nav__link::before {
      display: none;
    }

    .site-nav__details > .site-nav__sublist {
      position: static;
      min-width: 0;
      padding: 0 0 var(--space-3) var(--space-5);
      border: 0;
      background: none;
    }

    .site-nav__sublink {
      font-size: var(--text-body);
    }

    .site-nav__utility {
      display: block;
      margin-top: var(--space-5);
      padding-top: var(--space-3);
      border-top: var(--border-width) solid var(--color-rule);
    }

    .site-header__wide-only {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .site-header__toggle-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const setOpen = (header, open) => {
      const toggle = header?.querySelector('[data-menu-toggle]');
      if (!toggle) return;
      toggle.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-menu-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) header.querySelector('.site-nav a, .site-nav summary')?.focus({ preventScroll: true });
    };

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-menu-toggle]');
      if (toggle) {
        setOpen(toggle.closest('[data-site-header]'), toggle.getAttribute('aria-expanded') !== 'true');
        return;
      }
      document.querySelectorAll('.site-nav__details[open]').forEach((details) => {
        if (!details.contains(event.target)) details.open = false;
      });
      const openHeader = document.querySelector('[data-site-header][data-menu-open]');
      if (openHeader && (event.target.closest('.site-nav a') || event.target === openHeader)) setOpen(openHeader, false);
    });

    document.addEventListener('keydown', (event) => {
      const openHeader = document.querySelector('[data-site-header][data-menu-open]');
      if (event.key === 'Tab' && openHeader) {
        const focusable = [
          openHeader.querySelector('[data-menu-toggle]'),
          ...openHeader.querySelectorAll('.site-nav a, .site-nav summary'),
        ].filter((element) => element.getClientRects().length);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
        return;
      }
      if (event.key !== 'Escape') return;
      const details = event.target.closest?.('.site-nav__details[open]');
      if (details) {
        details.open = false;
        details.querySelector('summary').focus();
        return;
      }
      const header = document.querySelector('[data-site-header][data-menu-open]');
      if (header) {
        setOpen(header, false);
        header.querySelector('[data-menu-toggle]').focus();
      }
    });

    window.matchMedia('(min-width: 801px)').addEventListener('change', (event) => {
      if (event.matches) document.querySelectorAll('[data-site-header][data-menu-open]').forEach((header) => setOpen(header, false));
    });

    document.addEventListener('twp:cart-updated', (event) => {
      document.querySelectorAll('[data-cart-count]').forEach((element) => {
        element.textContent = String(event.detail.itemCount);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
